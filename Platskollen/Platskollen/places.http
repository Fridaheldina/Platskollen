@host = http://localhost:5166

### hämta alla platser
GET {{host}}/api/places

### lägg till en plats
POST {{host}}/api/places
Content-Type: application/json

{
    "name": "Hemavan",
    "category": "resmål",
    "description": "Turistort med skidåkning och fjällvandring",
    "latitude": 65.814075,
    "longitude": 15.101510
}

### Hämta en plats
GET {{host}}/api/places/1

### ta bort en plats
DELETE {{host}}/api/places/1

### Lägg till ytterligare en plats
POST {{host}}/api/places
Content-Type: application/json

{
    "name": "Fridas hem",
    "category": "Boende",
    "description": "Hemadress till Frida Lundberg",
    "latitude": 65.8382,
    "longitude": 14.9190
}
